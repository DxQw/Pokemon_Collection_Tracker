import os
from PIL import Image

EN_DIR = os.path.join(".", "pokemon_art_rarities", "en")

for root, _, files in os.walk(EN_DIR):
    for file in files:
        if file.lower().endswith((".png", ".jpg", ".jpeg")):
            filepath = os.path.join(root, file)
            
            with Image.open(filepath) as img:
                # Resize if larger than standard card display dimensions
                img.thumbnail((600, 800))
                
                # Overwrite/Save as compressed WebP or JPEG
                new_filepath = os.path.splitext(filepath)[0] + ".webp"
                img.save(new_filepath, "WEBP", quality=80)
                
            # Remove original heavy file if format changed
            if filepath != new_filepath:
                os.remove(filepath)

print("✓ Batch compression complete.")
